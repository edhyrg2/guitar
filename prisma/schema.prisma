generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserLevel {
  USER
  DEVELOPER
  MASTER
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  level           UserLevel @default(USER)
  photoUrl        String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customComponentDrafts CustomComponentDraft[]

  @@index([email])
  @@index([level])
  @@index([isActive])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  logo      String?
  website   String?
  type      String?
  country   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pickupModels PickupModel[]
  wireColorSchemas WireColorSchema[]

  @@index([name])
  @@index([active])
}

model PickupType {
  id          String  @id @default(cuid())
  name        String
  slug        String? @unique
  coilCount   String? @map("coil_count")
  isActive    Boolean @default(true) @map("is_active")
  description String?
  pickupModels PickupModel[]
  wireColorSchemas WireColorSchema[]

  @@index([name])
  @@index([isActive])
  @@map("pickup_types")
}

model PickupModel {
  id                String   @id @default(cuid())
  pickupBrandId     String   @map("pickup_brand_id")
  pickupTypeId      String   @map("pickup_type_id")
  name              String
  slug              String?  @unique
  positionType      String?  @map("position_type")
  wireCount         String?  @map("wire_count")
  magnetType        String?  @map("magnet_type")
  dcResistance      String?  @map("dc_resistance")
  outputLevel       String?  @map("output_level")
  isActivePickup    Boolean  @default(true) @map("is_active_pickup")
  colorCodeSchemaId String?  @map("color_code_schema_id")
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  pickupBrand       Brand    @relation(fields: [pickupBrandId], references: [id], onDelete: Restrict)
  pickupType        PickupType @relation(fields: [pickupTypeId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([pickupBrandId])
  @@index([pickupTypeId])
  @@index([isActivePickup])
  @@map("pickup_models")
}

model GuitarBrand {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  logoUrl   String?  @map("logo_url")
  country   String?
  website   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  guitarModels GuitarModel[]

  @@index([name])
  @@index([isActive])
  @@map("guitar_brands")
}

model GuitarModel {
  id                  String      @id @default(cuid())
  guitarBrandId       String      @map("guitar_brand_id")
  name                String
  slug                String?     @unique
  series              String?
  yearStart           Int?        @map("year_start")
  yearEnd             Int?        @map("year_end")
  bodyType            String?     @map("body_type")
  defaultPickupConfig String?     @map("default_pickup_config")
  description         String?
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  guitarBrand         GuitarBrand @relation(fields: [guitarBrandId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([guitarBrandId])
  @@index([isActive])
  @@map("guitar_models")
}

model WireColorSchema {
  id                   String    @id @default(cuid())
  pickupBrandId        String    @map("pickup_brand_id")
  name                 String
  pickupTypeId         String    @map("pickup_type_id")
  hotColor             String?   @map("hot_color")
  groundColor          String?   @map("ground_color")
  shieldColor          String?   @map("shield_color")
  northStartColor      String?   @map("north_start_color")
  northFinishColor     String?   @map("north_finish_color")
  southStartColor      String?   @map("south_start_color")
  southFinishColor     String?   @map("south_finish_color")
  batteryPositiveColor String?   @map("battery_positive_color")
  batteryNegativeColor String?   @map("battery_negative_color")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  pickupBrand          Brand     @relation(fields: [pickupBrandId], references: [id], onDelete: Restrict)
  pickupType           PickupType @relation(fields: [pickupTypeId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([pickupBrandId])
  @@index([pickupTypeId])
  @@map("wire_color_schemas")
}

model PickupConfiguration {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  pickupCount Int      @map("pickup_count")
  hasNeck     Boolean  @default(false) @map("has_neck")
  hasMiddle   Boolean  @default(false) @map("has_middle")
  hasBridge   Boolean  @default(false) @map("has_bridge")
  description String?
  wiringTemplates WiringTemplate[]

  @@index([name])
  @@index([pickupCount])
  @@map("pickup_configurations")
}

model SwitchType {
  id             String   @id @default(cuid())
  name           String
  slug           String?  @unique
  positionCount  Int      @map("position_count")
  poleCount      Int      @map("pole_count")
  lugCount       Int      @map("lug_count")
  switchCategory String?  @map("switch_category")
  description    String?
  svgAssetId     String?  @map("svg_asset_id")
  isActive       Boolean  @default(true) @map("is_active")
  wiringTemplates WiringTemplate[]

  @@index([name])
  @@index([isActive])
  @@map("switch_types")
}

model PotType {
  id          String   @id @default(cuid())
  name        String
  valueOhm    Int      @map("value_ohm")
  valueLabel  String   @map("value_label")
  taper       String?
  potFunction String?  @map("pot_function")
  isPushPull  Boolean  @default(false) @map("is_push_pull")
  isPushPush  Boolean  @default(false) @map("is_push_push")
  isNoLoad    Boolean  @default(false) @map("is_no_load")
  shaftType   String?  @map("shaft_type")
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  @@index([name])
  @@index([isActive])
  @@map("pot_types")
}

model Capacitor {
  id            String   @id @default(cuid())
  valueFarads   Float    @map("value_farads")
  valueLabel    String   @map("value_label")
  type          String?
  voltageRating String?  @map("voltage_rating")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")

  @@index([valueLabel])
  @@index([isActive])
  @@map("capacitors")
}

model Resistor {
  id          String   @id @default(cuid())
  valueOhm    Int      @map("value_ohm")
  valueLabel  String   @map("value_label")
  wattage     String?
  tolerance   String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  @@index([valueLabel])
  @@index([isActive])
  @@map("resistors")
}

model Mod {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String?  @unique
  description           String?
  requiresPushPull      Boolean  @default(false) @map("requires_push_pull")
  requiresMiniToggle    Boolean  @default(false) @map("requires_mini_toggle")
  requiresSpecialSwitch Boolean  @default(false) @map("requires_special_switch")
  difficultyLevel       String?  @map("difficulty_level")
  isActive              Boolean  @default(true) @map("is_active")

  @@index([name])
  @@index([isActive])
  @@map("mods")
}

model ComponentAsset {
  id               String   @id @default(cuid())
  ownerType        String?  @map("owner_type")
  ownerId          String?  @map("owner_id")
  componentType    String   @map("component_type")
  name             String
  slug             String?  @unique
  svgUrl           String?  @map("svg_url")
  thumbnailUrl     String?  @map("thumbnail_url")
  width            Int?
  height           Int?
  anchorPointsJson Json?    @map("anchor_points_json")
  editorDocumentJson Json?  @map("editor_document_json")
  styleType        String?  @map("style_type")
  isActive         Boolean  @default(true) @map("is_active")
  connectionPoints ComponentConnectionPoint[]
  templateComponents WiringTemplateComponent[]

  @@index([name])
  @@index([componentType])
  @@index([isActive])
  @@index([ownerType, ownerId])
  @@unique([ownerType, ownerId])
  @@map("component_assets")
}

model CustomComponentDraft {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  slug         String?  @unique
  description  String?
  documentJson Json     @map("document_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([name])
  @@index([updatedAt])
  @@map("custom_component_drafts")
}

model ComponentConnectionPoint {
  id               String         @id @default(cuid())
  componentAssetId String         @map("component_asset_id")
  pointKey         String         @map("point_key")
  label            String
  pointType        String         @map("point_type")
  x                Float
  y                Float
  description      String?
  componentAsset   ComponentAsset @relation(fields: [componentAssetId], references: [id], onDelete: Restrict)

  @@unique([componentAssetId, pointKey])
  @@index([componentAssetId])
  @@index([pointType])
  @@map("component_connection_points")
}

model WireType {
  id           String  @id @default(cuid())
  name         String
  color        String?
  hexColor     String? @map("hex_color")
  wireFunction String? @map("wire_function")
  isShielded   Boolean @default(false) @map("is_shielded")
  isGround     Boolean @default(false) @map("is_ground")
  description  String?
  templateConnections WiringTemplateConnection[]

  @@index([name])
  @@index([wireFunction])
  @@map("wire_types")
}

model WiringTemplate {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String?             @unique
  description           String?
  pickupConfigurationId String              @map("pickup_configuration_id")
  switchTypeId          String              @map("switch_type_id")
  volumeCount           Int                 @map("volume_count")
  toneCount             Int                 @map("tone_count")
  difficultyLevel       String?             @map("difficulty_level")
  diagramJson           Json                @map("diagram_json")
  switchLogicJson       Json                @map("switch_logic_json")
  isVerified            Boolean             @default(false) @map("is_verified")
  sourceType            String?             @map("source_type")
  sourceUrl             String?             @map("source_url")
  createdBy             String              @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  pickupConfiguration   PickupConfiguration @relation(fields: [pickupConfigurationId], references: [id], onDelete: Restrict)
  switchType            SwitchType          @relation(fields: [switchTypeId], references: [id], onDelete: Restrict)
  diagramSources        DiagramSource[]
  components            WiringTemplateComponent[]
  connections           WiringTemplateConnection[]

  @@index([name])
  @@index([pickupConfigurationId])
  @@index([switchTypeId])
  @@index([isVerified])
  @@map("wiring_templates")
}

model DiagramSource {
  id               String         @id @default(cuid())
  wiringTemplateId String         @map("wiring_template_id")
  sourceName       String         @map("source_name")
  sourceBrand      String?        @map("source_brand")
  sourceUrl        String?        @map("source_url")
  sourceFileUrl    String?        @map("source_file_url")
  sourceType       String?        @map("source_type")
  licenseNotes     String?        @map("license_notes")
  isOfficial       Boolean        @default(false) @map("is_official")
  verifiedAt       DateTime?      @map("verified_at")
  notes            String?
  wiringTemplate   WiringTemplate @relation(fields: [wiringTemplateId], references: [id], onDelete: Restrict)

  @@index([wiringTemplateId])
  @@index([sourceType])
  @@index([isOfficial])
  @@index([verifiedAt])
  @@map("diagram_sources")
}

model WiringTemplateComponent {
  id               String         @id @default(cuid())
  wiringTemplateId String         @map("wiring_template_id")
  componentRole    String         @map("component_role")
  componentType    String         @map("component_type")
  assetId          String         @map("asset_id")
  positionX        Float          @map("position_x")
  positionY        Float          @map("position_y")
  rotation         Float          @default(0)
  metadataJson     Json?          @map("metadata_json")
  wiringTemplate   WiringTemplate @relation(fields: [wiringTemplateId], references: [id], onDelete: Restrict)
  asset            ComponentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([wiringTemplateId])
  @@index([assetId])
  @@index([componentRole])
  @@map("wiring_template_components")
}

model WiringTemplateConnection {
  id                String         @id @default(cuid())
  wiringTemplateId  String         @map("wiring_template_id")
  fromComponentRole String         @map("from_component_role")
  fromPointKey      String         @map("from_point_key")
  toComponentRole   String         @map("to_component_role")
  toPointKey        String         @map("to_point_key")
  wireTypeId        String         @map("wire_type_id")
  wireColor         String?        @map("wire_color")
  pathJson          Json?          @map("path_json")
  label             String?
  notes             String?
  wiringTemplate    WiringTemplate @relation(fields: [wiringTemplateId], references: [id], onDelete: Restrict)
  wireType          WireType       @relation(fields: [wireTypeId], references: [id], onDelete: Restrict)

  @@index([wiringTemplateId])
  @@index([wireTypeId])
  @@index([fromComponentRole])
  @@index([toComponentRole])
  @@map("wiring_template_connections")
}
